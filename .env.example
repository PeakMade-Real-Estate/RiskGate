# Azure/Microsoft Entra ID Configuration
# Copy this file to .env and fill in your actual values

# Required for Microsoft authentication
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here

# Optional - Flask configuration
SECRET_KEY=your_secret_key_here
DATABASE_URL=sqlite:///securityscan.db

# Optional - Application settings
PORT=5003
PRODUCTION_URL=https://your-app-name.azurewebsites.net

# Testing Mode - Enable test authentication without Microsoft (set to false for production)
TESTING_MODE=true
